{
  "name": "vscode-herdr-extension",
  "displayName": "Herdr",
  "description": "Navigate and interact with local Herdr sessions from VS Code.",
  "version": "0.0.1",
  "publisher": "St0necrusher",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/src/extension/activate.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "herdr.showStatusActions",
        "title": "Herdr: Show Status Actions"
      },
      {
        "command": "herdr.retryDiscovery",
        "title": "Herdr: Retry Discovery"
      },
      {
        "command": "herdr.start",
        "title": "Herdr: Start Herdr"
      },
      {
        "command": "herdr.selectExecutable",
        "title": "Herdr: Select Herdr Executable"
      },
      {
        "command": "herdr.openSettings",
        "title": "Herdr: Open Settings"
      }
    ],
    "configuration": {
      "title": "Herdr",
      "properties": {
        "herdr.executable": {
          "type": "string",
          "default": "herdr",
          "description": "Path to the Herdr executable."
        },
        "herdr.session": {
          "type": "string",
          "default": "default",
          "description": "Herdr Session to discover and start. Use default for the default Session."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test && node scripts/check-architecture.mjs && dependency-cruiser src --config dependency-cruiser.config.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:extension": "npm run build && vscode-test --config .vscode-test.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.6",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^5.0.1"
  }
}
