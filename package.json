{
  "name": "herdr-layout-projection-prototype",
  "displayName": "Herdr Layout Projection Prototype",
  "description": "THROWAWAY prototype for projecting a Herdr Tab into native VS Code editor groups.",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./prototype/layout-projection/extension.js",
  "activationEvents": [
    "onCommand:herdrPrototype.openLayoutFixture",
    "onCommand:herdrPrototype.openRealLayout",
    "onCommand:herdrPrototype.auditEditorState",
    "onCommand:herdrPrototype.closeLayoutSurfaces"
  ],
  "contributes": {
    "commands": [
      {
        "command": "herdrPrototype.openLayoutFixture",
        "title": "Herdr Prototype: Open Layout Fixture"
      },
      {
        "command": "herdrPrototype.openRealLayout",
        "title": "Herdr Prototype: Open Real Panes as Layout"
      },
      {
        "command": "herdrPrototype.auditEditorState",
        "title": "Herdr Prototype: Audit Editor State"
      },
      {
        "command": "herdrPrototype.closeLayoutSurfaces",
        "title": "Herdr Prototype: Close Layout Surfaces"
      }
    ],
    "configuration": {
      "title": "Herdr Layout Projection Prototype",
      "properties": {
        "herdrPrototype.binary": {
          "type": "string",
          "default": "herdr",
          "description": "Path to the Herdr 0.9.0 executable."
        },
        "herdrPrototype.session": {
          "type": "string",
          "default": "vscode-bridge-prototype",
          "description": "Named Herdr Session used by the real-Pane experiment. Leave empty for the default Session."
        }
      }
    }
  },
  "scripts": {
    "check:prototype": "node --check prototype/layout-projection/extension.js"
  }
}
