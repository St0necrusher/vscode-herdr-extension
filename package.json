{
  "name": "herdr-direct-attach-handoff-prototype",
  "displayName": "Herdr Direct Attach Handoff Prototype",
  "description": "THROWAWAY prototype for switching one VS Code terminal surface between Herdr observation and official direct attach.",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./prototype/direct-attach-handoff/extension.js",
  "activationEvents": [
    "onCommand:herdrPrototype.openDirectAttachHandoff",
    "onCommand:herdrPrototype.yieldControl",
    "onCommand:herdrPrototype.takeControl"
  ],
  "contributes": {
    "commands": [
      {
        "command": "herdrPrototype.openDirectAttachHandoff",
        "title": "Herdr Prototype: Open Direct-Attach Handoff"
      },
      {
        "command": "herdrPrototype.yieldControl",
        "title": "Herdr Prototype: Yield Control"
      },
      {
        "command": "herdrPrototype.takeControl",
        "title": "Herdr Prototype: Take Control"
      }
    ],
    "configuration": {
      "title": "Herdr Direct Attach Handoff Prototype",
      "properties": {
        "herdrPrototype.binary": {
          "type": "string",
          "default": "herdr",
          "description": "Path to the Herdr executable."
        },
        "herdrPrototype.session": {
          "type": "string",
          "default": "",
          "description": "Optional named Herdr Session. Leave empty for the default Session."
        },
        "herdrPrototype.autoYieldOnBlur": {
          "type": "boolean",
          "default": true,
          "description": "Immediately stop direct attach when the terminal or VS Code window loses focus."
        },
        "herdrPrototype.autoTakeOnFocus": {
          "type": "boolean",
          "default": true,
          "description": "Start direct attach when this prototype terminal gains focus."
        },
        "herdrPrototype.idleReleaseMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 600000,
          "description": "Release direct attach after this many milliseconds without local terminal input, resize, or focus activity. Set to 0 to disable inactivity Yield."
        }
      }
    }
  },
  "scripts": {
    "check:prototype": "node --check prototype/direct-attach-handoff/extension.js"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.13"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.6",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^5.0.1"
  }
}
