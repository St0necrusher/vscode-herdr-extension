{
  "name": "vscode-herdr-extension",
  "displayName": "Herdr",
  "description": "Navigate and interact with local Herdr sessions from VS Code.",
  "version": "0.0.1",
  "publisher": "St0necrusher",
  "private": true,
  "license": "MIT",
  "prettier": {
    "printWidth": 120
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "herdr.installMobileTakeoverPlugin",
        "title": "Herdr: Install Mobile Takeover Plugin"
      },
      {
        "command": "herdr.removeMobileTakeoverPlugin",
        "title": "Herdr: Remove Mobile Takeover Plugin"
      },
      {
        "command": "herdr.showStatusActions",
        "title": "Herdr: Show Status Actions"
      },
      {
        "command": "herdr.retryDiscovery",
        "title": "Herdr: Retry Discovery"
      },
      {
        "command": "herdr.start",
        "title": "Herdr: Start Herdr"
      },
      {
        "command": "herdr.selectExecutable",
        "title": "Herdr: Select Herdr Executable"
      },
      {
        "command": "herdr.openSettings",
        "title": "Herdr: Open Settings"
      },
      {
        "command": "herdr.selectSession",
        "title": "Herdr: Select Herdr Session"
      },
      {
        "command": "herdr.selectSpace",
        "title": "Herdr: Select Herdr Space"
      },
      {
        "command": "herdr.refreshSessions",
        "title": "Herdr: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "herdr.openPane",
        "title": "Herdr: Open Pane"
      },
      {
        "command": "herdr.openAgentPane",
        "title": "Herdr: Open Agent Pane"
      },
      {
        "command": "herdr.createSpace",
        "title": "Herdr: New Space",
        "icon": "$(add)",
        "enablement": "herdr.spaceActionsEnabled"
      },
      {
        "command": "herdr.createPane",
        "title": "Herdr: New Pane",
        "icon": "$(add)",
        "enablement": "herdr.paneActionsEnabled"
      },
      {
        "command": "herdr.splitPaneRight",
        "title": "Herdr: Split Pane Right",
        "icon": "$(split-horizontal)",
        "enablement": "herdr.paneActionsEnabled"
      },
      {
        "command": "herdr.splitPaneDown",
        "title": "Herdr: Split Pane Down",
        "icon": "$(split-vertical)",
        "enablement": "herdr.paneActionsEnabled"
      },
      {
        "command": "herdr.renamePane",
        "title": "Herdr: Rename Pane…",
        "icon": "$(edit)",
        "enablement": "herdr.paneActionsEnabled"
      },
      {
        "command": "herdr.renameTab",
        "title": "Herdr: Rename Tab…",
        "icon": "$(edit)",
        "enablement": "herdr.paneActionsEnabled"
      },
      {
        "command": "herdr.closePane",
        "title": "Herdr: Close Pane",
        "icon": "$(close-small)",
        "enablement": "herdr.paneActionsEnabled"
      },
      {
        "command": "herdr.closeTab",
        "title": "Herdr: Close Tab",
        "icon": "$(close-small)",
        "enablement": "herdr.paneActionsEnabled"
      },
      {
        "command": "herdr.runNpmScript",
        "title": "Run Script in Herdr",
        "icon": "$(terminal)",
        "enablement": "herdr.paneActionsEnabled"
      },
      {
        "command": "herdr.runNpmScriptAtCursor",
        "title": "Run Script in Herdr",
        "enablement": "herdr.paneActionsEnabled"
      },
      {
        "command": "herdr.runNpmScriptFromHover",
        "title": "Run Script in Herdr"
      },
      {
        "command": "herdr.renameSpace",
        "title": "Herdr: Rename Space…",
        "icon": "$(edit)",
        "enablement": "herdr.spaceActionsEnabled"
      },
      {
        "command": "herdr.closeSpace",
        "title": "Herdr: Close Space",
        "icon": "$(close-small)",
        "enablement": "herdr.spaceActionsEnabled"
      },
      {
        "command": "herdr.closeGroup",
        "title": "Herdr: Close Group",
        "icon": "$(close-small)",
        "enablement": "herdr.spaceActionsEnabled"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "herdr",
          "title": "Herdr",
          "icon": "media/herdr.svg"
        }
      ]
    },
    "views": {
      "herdr": [
        {
          "id": "herdr.sessions",
          "name": "Sessions"
        },
        {
          "id": "herdr.spaces",
          "name": "Spaces"
        },
        {
          "id": "herdr.panes",
          "name": "Panes"
        },
        {
          "id": "herdr.agents",
          "name": "Agents"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "herdr.runNpmScriptAtCursor",
          "when": "resourceFilename == 'package.json' && resourceScheme == file",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "herdr.refreshSessions",
          "when": "view == herdr.sessions",
          "group": "navigation"
        },
        {
          "command": "herdr.createSpace",
          "when": "view == herdr.spaces",
          "group": "navigation"
        },
        {
          "command": "herdr.createPane",
          "when": "view == herdr.panes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "herdr.runNpmScript",
          "when": "view == npm && viewItem == script",
          "group": "inline"
        },
        {
          "command": "herdr.runNpmScript",
          "when": "view == npm && viewItem == script",
          "group": "navigation@4"
        },
        {
          "command": "herdr.renamePane",
          "when": "view == herdr.panes && viewItem =~ /^herdr\\.panes\\.(pane|singleton)(?:\\.closable)?$/",
          "group": "edit@1"
        },
        {
          "command": "herdr.renameTab",
          "when": "view == herdr.panes && viewItem =~ /^herdr\\.panes\\.(group|singleton)(?:\\.closable)?$/",
          "group": "edit@2"
        },
        {
          "command": "herdr.closePane",
          "when": "view == herdr.panes && viewItem =~ /^herdr\\.panes\\.(pane|singleton)\\.closable$/",
          "group": "close@1"
        },
        {
          "command": "herdr.closeTab",
          "when": "view == herdr.panes && viewItem =~ /^herdr\\.panes\\.group\\.closable$/",
          "group": "close@2"
        },
        {
          "command": "herdr.renameSpace",
          "when": "view == herdr.spaces && viewItem =~ /^herdr\\.space(?:\\.selected)?(?:\\.group)?$/",
          "group": "edit@1"
        },
        {
          "command": "herdr.closeSpace",
          "when": "view == herdr.spaces && viewItem =~ /^herdr\\.space(?:\\.selected)?$/",
          "group": "close@1"
        },
        {
          "command": "herdr.closeGroup",
          "when": "view == herdr.spaces && viewItem =~ /^herdr\\.space(?:\\.selected)?\\.group$/",
          "group": "close@1"
        },
        {
          "command": "herdr.closePane",
          "when": "view == herdr.panes && viewItem =~ /^herdr\\.panes\\.(pane|singleton)\\.closable$/ && config.herdr.views.showInlineClose",
          "group": "inline"
        },
        {
          "command": "herdr.closeTab",
          "when": "view == herdr.panes && viewItem =~ /^herdr\\.panes\\.group\\.closable$/ && config.herdr.views.showInlineClose",
          "group": "inline"
        },
        {
          "command": "herdr.closeSpace",
          "when": "view == herdr.spaces && viewItem =~ /^herdr\\.space(?:\\.selected)?$/ && config.herdr.views.showInlineClose",
          "group": "inline"
        },
        {
          "command": "herdr.closeGroup",
          "when": "view == herdr.spaces && viewItem =~ /^herdr\\.space(?:\\.selected)?\\.group$/ && config.herdr.views.showInlineClose",
          "group": "inline"
        },
        {
          "command": "herdr.splitPaneRight",
          "when": "view == herdr.panes && viewItem =~ /^herdr\\.panes\\.(pane|singleton)(?:\\.closable)?$/",
          "group": "split@1"
        },
        {
          "command": "herdr.splitPaneDown",
          "when": "view == herdr.panes && viewItem =~ /^herdr\\.panes\\.(pane|singleton)(?:\\.closable)?$/",
          "group": "split@2"
        }
      ],
      "commandPalette": [
        {
          "command": "herdr.openAgentPane",
          "when": "false"
        },
        {
          "command": "herdr.splitPaneRight",
          "when": "false"
        },
        {
          "command": "herdr.splitPaneDown",
          "when": "false"
        },
        {
          "command": "herdr.renamePane",
          "when": "false"
        },
        {
          "command": "herdr.renameTab",
          "when": "false"
        },
        {
          "command": "herdr.closePane",
          "when": "false"
        },
        {
          "command": "herdr.closeTab",
          "when": "false"
        },
        {
          "command": "herdr.renameSpace",
          "when": "false"
        },
        {
          "command": "herdr.closeSpace",
          "when": "false"
        },
        {
          "command": "herdr.closeGroup",
          "when": "false"
        },
        {
          "command": "herdr.runNpmScript",
          "when": "false"
        },
        {
          "command": "herdr.runNpmScriptAtCursor",
          "when": "false"
        },
        {
          "command": "herdr.runNpmScriptFromHover",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Herdr",
      "properties": {
        "herdr.executable": {
          "type": "string",
          "default": "herdr",
          "description": "Path to the Herdr executable."
        },
        "herdr.session": {
          "type": "string",
          "default": "default",
          "description": "Initial Herdr Session preference/fallback when no valid saved per-workspace/window selection exists; use default for the default Session. This setting does not start a Session automatically."
        },
        "herdr.views.showInlineClose": {
          "type": "boolean",
          "default": true,
          "description": "Show an inline close button on Pane, Tab, and Space rows in the Herdr views. Close actions stay available in the context menu."
        }
      }
    },
    "keybindings": [
      {
        "key": "up",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
          "text": "\u001b]herdr;arrow-up\u0007"
        },
        "when": "terminalFocus && herdr.activeTerminalIsPane && !terminalFindFocused"
      },
      {
        "key": "down",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
          "text": "\u001b]herdr;arrow-down\u0007"
        },
        "when": "terminalFocus && herdr.activeTerminalIsPane && !terminalFindFocused"
      }
    ]
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test herdr-plugin",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:extension": "npm run build && vscode-test --config .vscode-test.mjs",
    "package": "npm run build && vsce package --out herdr.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.6",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "node-pty": "1.2.0-beta.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/St0necrusher/vscode-herdr-extension.git"
  }
}
