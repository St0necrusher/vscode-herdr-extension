{
  "name": "vscode-herdr-extension",
  "displayName": "Herdr",
  "description": "Navigate and interact with local Herdr sessions from VS Code.",
  "version": "0.0.1",
  "publisher": "St0necrusher",
  "private": true,
  "license": "MIT",
  "prettier": {
    "printWidth": 120
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "herdr.showStatusActions",
        "title": "Herdr: Show Status Actions"
      },
      {
        "command": "herdr.retryDiscovery",
        "title": "Herdr: Retry Discovery"
      },
      {
        "command": "herdr.start",
        "title": "Herdr: Start Herdr"
      },
      {
        "command": "herdr.selectExecutable",
        "title": "Herdr: Select Herdr Executable"
      },
      {
        "command": "herdr.openSettings",
        "title": "Herdr: Open Settings"
      },
      {
        "command": "herdr.selectSession",
        "title": "Herdr: Select Herdr Session"
      },
      {
        "command": "herdr.selectSpace",
        "title": "Herdr: Select Herdr Space"
      },
      {
        "command": "herdr.refreshSessions",
        "title": "Herdr: Refresh Sessions",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "herdr",
          "title": "Herdr",
          "icon": "media/herdr.svg"
        }
      ]
    },
    "views": {
      "herdr": [
        {
          "id": "herdr.sessions",
          "name": "Sessions"
        },
        {
          "id": "herdr.spaces",
          "name": "Spaces"
        },
        {
          "id": "herdr.panes",
          "name": "Panes"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "herdr.refreshSessions",
          "when": "view == herdr.sessions",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Herdr",
      "properties": {
        "herdr.executable": {
          "type": "string",
          "default": "herdr",
          "description": "Path to the Herdr executable."
        },
        "herdr.session": {
          "type": "string",
          "default": "default",
          "description": "Initial Herdr Session preference/fallback when no valid saved per-workspace/window selection exists; use default for the default Session. This setting does not start a Session automatically."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:extension": "npm run build && vscode-test --config .vscode-test.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.6",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^5.0.1"
  }
}
